# ------------------------------------------------------------------ App
APP_NAME=Studiepilot
# Public URL (used in password-reset emails). Change when you host it.
APP_URL=http://localhost:8088
# local | production   (local shows password-reset links on screen when no mail server is set up)
APP_ENV=local
APP_TIMEZONE=Europe/Amsterdam
# Secret used to encrypt API keys stored in the database. Generate one with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# If empty, a key is generated automatically in storage/app.key (keep that file safe & backed up).
APP_KEY=

# ------------------------------------------------------------------ AI (OpenRouter)
# One or more OpenRouter keys, comma separated. Requests rotate between them and fail over
# automatically when a key is invalid, out of credits or rate limited.
# You can ALSO add/remove keys in the app: Settings → AI provider (admin only).
OPENROUTER_API_KEYS=
# Any OpenAI-compatible endpoint works.
AI_BASE_URL=https://openrouter.ai/api/v1
# Main model for analysis, quizzes, tutor and grading.
AI_MODEL=google/gemini-2.5-flash
# Model for OCR of images/scans (must accept images). Defaults to AI_MODEL.
AI_VISION_MODEL=
# Optional: semantic search for the tutor/search (e.g. openai/text-embedding-3-small). Empty = keyword search (BM25).
AI_EMBEDDING_MODEL=

# ------------------------------------------------------------------ Database
# sqlite (zero setup) or mysql
DB_DRIVER=sqlite
DB_DATABASE=storage/database.sqlite
# MySQL / MariaDB settings (when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studyai
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------ Uploads
MAX_UPLOAD_MB=50
MAX_ZIP_UNCOMPRESSED_MB=500
MAX_STORAGE_MB_PER_USER=2000
# Allow importing URLs on private/local networks (keep false on a public server).
ALLOW_PRIVATE_URLS=false

# ------------------------------------------------------------------ Mail (password reset)
# log = write emails to storage/logs/mail.log | mail = PHP mail() | smtp
MAIL_DRIVER=log
MAIL_FROM="Studiepilot <no-reply@studiepilot.dk>"
SMTP_HOST=
SMTP_PORT=587
# tls | ssl | none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# Optional path to a CA bundle if HTTPS requests fail with "SSL certificate problem"
CURL_CA_BUNDLE=

# ------------------------------------------------------------------ Hosting (cron)
# Secret for https://your-domain/cron.php?key=... (shared hosting scheduler, e.g. Simply.com).
# Generate one: php -r "echo bin2hex(random_bytes(20)), PHP_EOL;"
CRON_KEY=
# How long one cron run may keep processing (seconds)
CRON_SECONDS=50

# ------------------------------------------------------------------ AI speed / limits
# Background AI tasks running at the same time (analysis, question pool). Lower = gentler on rate limits.
AI_PARALLEL=2
# How many models are raced for requests a student is waiting on (higher = faster, uses more quota).
AI_RACE_MODELS=3
# Max seconds a request waits for a rate-limited key before giving up.
AI_MAX_WAIT_SECONDS=150

# --- Rate limiting (requests per user when signed in, per IP address otherwise; 0 = off)
# Login has its own limits: 8 wrong attempts per account and 30 per IP address per 15 minutes.
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_PER_HOUR=6000
RATE_LIMIT_ANON_PER_MINUTE=60
# AI and heavy routes (AI tutor, opgavefeedback, uploads, search …)
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_AI_PER_HOUR=200

# --- AI speed
# Seconds a model may stay silent before the next model is tried (live answers)
AI_FIRST_TOKEN_SECONDS=12
# How many of the fastest models are tried while a student waits
AI_INTERACTIVE_MODELS=4
# Identical questions get the saved answer instantly (no AI quota used)
AI_CACHE=true
AI_CACHE_DAYS=14
